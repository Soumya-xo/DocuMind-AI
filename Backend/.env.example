PORT=5001
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id

# Optional: Gemini fallback for text chat, used only when Ollama is
# unavailable (connection failure, timeout, or server error). Ollama is
# always tried first. Leave GEMINI_API_KEY unset to disable the fallback
# entirely — the app works exactly as before with just Ollama.
GEMINI_API_KEY=YOUR_REAL_KEY
GEMINI_MODEL=gemini-3.6-flash

# Backup Gemini model used only when GEMINI_MODEL itself returns a temporary
# 503/UNAVAILABLE error after retries during streaming (see aiProvider.js).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Embedding provider used for document indexing/retrieval (FAISS). Ollama
# and Gemini embeddings are NOT compatible with each other and are stored
# in separate per-user vector stores — never mixed in the same index.
#
# ollama (default): local, uses nomic-embed-text via Ollama. No API key
#                   needed. This is the existing local dev behavior.
# gemini:           cloud, uses the Gemini Embedding API. Requires
#                   GEMINI_API_KEY above to be set — there is no silent
#                   fallback to Ollama if it's missing.
AI_EMBEDDING_PROVIDER=gemini

# Only used when AI_EMBEDDING_PROVIDER=gemini. Reuses GEMINI_API_KEY above
# (same key as the text-generation fallback) — no separate key needed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
